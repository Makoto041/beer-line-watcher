generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Source {
  id          String   @id
  name        String
  url         String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  events      Event[]
}

model Event {
  id           String    @id
  sourceId     String
  title        String
  url          String
  createdAt    DateTime  @default(now())
  eventDate    DateTime?
  eventEndDate DateTime?
  source       Source    @relation(fields: [sourceId], references: [id])
}

model LineSubscriber {
  userId           String    @id
  createdAt        DateTime  @default(now())
  lastNotifiedAt   DateTime?
  notificationDays Int       @default(7)
}

model LineGroup {
  id               String    @id
  type             String
  notificationDays Int       @default(7)
  lastNotifiedAt   DateTime?
  createdAt        DateTime  @default(now())
}
