datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

model Source {
  id          String   @id        // "beergirl-calendar" など
  name        String
  url         String
  description String?
  events      Event[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id        String    @id          // sourceId:url のハッシュなど
  sourceId  String
  source    Source    @relation(fields: [sourceId], references: [id])
  title     String
  url       String
  eventDate DateTime?              // イベント開催日（スクレイピングで取得）
  createdAt DateTime  @default(now())
}

model LineSubscriber {
  userId             String   @id
  notificationDays   Int      @default(7)  // 通知間隔（日数）: 1, 7, 14, 30（デフォルト週1回）
  lastNotifiedAt     DateTime?             // 最後に通知した日時
  createdAt          DateTime @default(now())
}

model LineGroup {
  id                 String   @id  // groupId or roomId
  type               String        // "group" or "room"
  notificationDays   Int      @default(7)  // 通知間隔（日数）: 1, 7, 14, 30（デフォルト週1回）
  lastNotifiedAt     DateTime?             // 最後に通知した日時
  createdAt          DateTime @default(now())
}